# sites_base.rq — 中央区の座標付き地物(基本形・小さく確認するための叩き台)
# ⚠ loop_001 で必ず検証すること:
#   - wd:QXXXXXX は中央区(東京都)の QID に置換(仮置き。誤りうる)
#   - 対象クラス(記念碑/史跡/文化財)のうち実際にヒットが集まるものを確認
#   - LIMIT を付けたまま件数感を掴み、確認後に本実装へ

SELECT ?item ?itemLabel ?coord ?instanceOf ?instanceOfLabel WHERE {
  ?item wdt:P131 wd:QXXXXXX .          # 所在行政区 = 中央区(東京都)※要確定
  ?item wdt:P625 ?coord .              # 座標
  ?item wdt:P31 ?instanceOf .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ja,en". }
}
LIMIT 200
